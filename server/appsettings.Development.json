{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Oura": {
    // In development the browser talks to the Vite dev server, which proxies /api to
    // the backend, so Oura must redirect back through Vite. Register this exact URI.
    "RedirectUri": "http://localhost:5173/api/oura/callback"
  }
}
